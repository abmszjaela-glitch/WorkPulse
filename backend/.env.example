# Copy to .env and supply your existing Supabase project values.
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
# Backend-only secret preferred. Never put it in frontend environment files.
SUPABASE_SECRET_KEY=
# Used only when no secret key is configured; Supabase RLS still applies.
SUPABASE_PUBLISHABLE_KEY=
# Optional exact frontend origin; cross-origin browser access is disabled if unset.
CORS_ORIGIN=http://localhost:5173

# Custom WorkPulse auth. Generate a cryptographically random secret of >=32 bytes.
# No fallback secret is provided. Keep these values server-only.
AUTH_JWT_SECRET=
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=604800
AUTH_RESET_SECONDS=1800
AUTH_TEMPORARY_SECONDS=86400
AUTH_BCRYPT_ROUNDS=12

# Custom password recovery; no Supabase Auth sessions/tokens are used.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=
# Must be an HTTPS page capable of reading #token=... and POSTing the reset request.
PASSWORD_RESET_URL=

# Authorized device policy, in seconds; local employee stop must always prevail.
AGENT_IDLE_THRESHOLD=300
AGENT_TRACKING_INTERVAL=60
AGENT_TIMEZONE=Asia/Colombo
AGENT_WORK_START=09:00
AGENT_WORK_END=17:30
# ISO weekdays: Monday=1 ... Sunday=7
AGENT_WORK_DAYS=1,2,3,4,5

# Monitoring ingress limits and heartbeat-based connectivity (seconds unless noted).
MONITORING_MAX_BATCH_SIZE=100
MONITORING_MAX_RECORD_BYTES=262144
MONITORING_MAX_AGE_DAYS=30
MONITORING_MAX_INTERVAL_SECONDS=86400
MONITORING_FUTURE_SKEW_SECONDS=300
MONITORING_CLOCK_TOLERANCE_SECONDS=5
DEVICE_OFFLINE_TIMEOUT_SECONDS=300
MONITORING_REQUESTS_PER_MINUTE=120

# Opt in only AFTER approving/applying migrations and reviewing reporting timezone.
DAILY_SUMMARY_WORKER_ENABLED=false
SUMMARY_TIMEZONE=Asia/Colombo
# Optional first report date, YYYY-MM-DD; blank starts a bounded recent catch-up.
SUMMARY_START_DATE=
SUMMARY_LOOKBACK_DAYS=30
SUMMARY_CATCHUP_DAYS=7
SUMMARY_MAX_JOBS_PER_RUN=50
SUMMARY_DELAY_MINUTES=5
SUMMARY_POLL_SECONDS=60

REPORT_CSV_MAX_ROWS=10000
REPORT_PDF_MAX_ROWS=2000
# Optional server-controlled font file for the languages present in report data.
REPORT_FONT_PATH=

# Socket origins share CORS_ORIGIN (comma-separated exact HTTP(S) origins).
# Enable database outbox/presence sweeping only after approved migration 007.
REALTIME_WORKER_ENABLED=false
REALTIME_POLL_MS=2000
SOCKET_REVALIDATE_MS=10000
SOCKET_AUTH_ATTEMPTS_PER_MINUTE=60
# Release policy must be explicitly configured; no production download URL is assumed.
AGENT_MIN_VERSION=
AGENT_LATEST_VERSION=
AGENT_INSTALLER_URL=
AGENT_INSTALLER_SHA256=
AGENT_INSTALLER_BYTES=
